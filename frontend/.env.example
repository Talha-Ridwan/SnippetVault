# -----------------------------------------------------------------------------
# FRONTEND (React + Vite)
# Only variables prefixed with VITE_ are exposed to client code via
# import.meta.env. Everything in this file is inlined into the browser bundle
# at build time — never put secrets here.
# -----------------------------------------------------------------------------

# Base URL prepended to the GitHub login redirect (pages/login.tsx).
# Leave EMPTY for the docker-compose setup: nginx serves the app on :8080 and
# proxies /api to the backend, so the request is same-origin.
# Set to http://localhost:8080 only if you run `npm run dev` directly on :5173.
VITE_API_URL=
