APP_NAME=SnippetVault
APP_ENV=local
APP_KEY=base64:tTX9XwtRaekT01bLfnmE7Tz2ctZOzZkK5TPb06RNZcI=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Public entrypoint — nginx (docker-compose maps 8080:80 and proxies /api to backend:8000)
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# DATABASE — matches the mysql service in docker-compose.yml
# Inside the container, compose injects DB_HOST=mysql and overrides these.
# From the host (php artisan ...), 127.0.0.1:3306 is the published port.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=snippetvault
DB_USERNAME=snippetuser
DB_PASSWORD=snippetvault_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# -----------------------------------------------------------------------------
# REDIS — matches the redis service in docker-compose.yml
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# AUTH — GitHub OAuth (Socialite) + Sanctum
# Fill CLIENT_ID / CLIENT_SECRET from https://github.com/settings/developers
# The callback below must match the OAuth app's "Authorization callback URL".
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/github/callback

# Where AuthController sends the browser after login / on error
FRONTEND_URL=http://localhost:8080

SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:5173,127.0.0.1:8080
